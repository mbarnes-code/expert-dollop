{
	"name": "omninexus",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"args": {
			"VARIANT": "3.12-bookworm",
			"NODE_VERSION": "22"
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"dockerDashComposeVersion": "v2"
		},
		"ghcr.io/devcontainers/features/rust:1": {
			"version": "stable"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-contrib/features/black:1": {},
		"ghcr.io/devcontainers-contrib/features/coverage-py:1": {}
	},
	"containerEnv": {
		"DISPLAY": ":99"
	},
	"mounts": [
		"source=omninexus-node_modules,target=/workspaces/expert-dollop/node_modules,type=volume",
		"source=omninexus-bashhistory,target=/home/vscode/commandhistory,type=volume",
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,consistency=cached"
	],
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.formatting.autopep8Path": "/usr/local/py-utils/bin/autopep8",
				"python.formatting.blackPath": "/usr/local/py-utils/bin/black",
				"python.formatting.yapfPath": "/usr/local/py-utils/bin/yapf",
				"mypy.runUsingActiveInterpreter": true,
				"terminal.integrated.defaultProfile.linux": "bash",
				"resmon.show.battery": false,
				"resmon.show.cpufreq": false
			},
			"extensions": [
				// Python
				"charliermarsh.ruff",
				"matangover.mypy",
				"ms-python.black-formatter",
				"ms-python.pylint",
				"ms-python.python",
				"ms-python.vscode-pylance",
				// JavaScript/TypeScript
				"dbaeumer.vscode-eslint",
				"Vue.volar",
				// Rust
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb",
				// Git/GitHub
				"GitHub.vscode-pull-request-github",
				"GitHub.vscode-github-actions",
				"ms-vscode.vscode-github-issue-notebooks",
				// Utilities
				"EditorConfig.EditorConfig",
				"mutantdino.resourcemonitor",
				"ms-vscode.vscode-selfhost-test-provider"
			]
		},
		"codespaces": {
			"openFiles": ["README.md"]
		}
	},
	"forwardPorts": [
		3000,  // Frontend dev servers
		5432,  // PostgreSQL
		5678,  // n8n
		6080,  // VNC web client (noVNC)
		8000,  // API services
		8001,  // Kong admin
		8080,  // Various web services
		9000,  // Services
		9091   // Production services
	],
	"portsAttributes": {
		"6080": {
			"label": "VNC web client (noVNC)",
			"onAutoForward": "silent"
		},
		"5901": {
			"label": "VNC TCP port",
			"onAutoForward": "silent"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "notify"
		},
		"8000": {
			"label": "API Server",
			"onAutoForward": "notify"
		}
	},
	"onCreateCommand": "sudo chown -R vscode:vscode /workspaces/expert-dollop/node_modules /home/vscode/commandhistory",
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"remoteUser": "vscode",
	"privileged": true,
	"hostRequirements": {
		"memory": "8gb",
		"cpus": 4
	}
}
