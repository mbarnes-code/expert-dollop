{
  "index_patterns": ["zeek-*", "suricata-*", "pcap-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s",
        "codec": "best_compression"
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event": {
          "properties": {
            "category": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "dataset": {
              "type": "keyword"
            },
            "severity": {
              "type": "long"
            }
          }
        },
        "network": {
          "properties": {
            "protocol": {
              "type": "keyword"
            },
            "transport": {
              "type": "keyword"
            },
            "direction": {
              "type": "keyword"
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            },
            "community_id": {
              "type": "keyword"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            },
            "mac": {
              "type": "keyword"
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            },
            "geo": {
              "properties": {
                "country_name": {
                  "type": "keyword"
                },
                "city_name": {
                  "type": "keyword"
                },
                "location": {
                  "type": "geo_point"
                }
              }
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            },
            "mac": {
              "type": "keyword"
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            },
            "geo": {
              "properties": {
                "country_name": {
                  "type": "keyword"
                },
                "city_name": {
                  "type": "keyword"
                },
                "location": {
                  "type": "geo_point"
                }
              }
            }
          }
        },
        "dns": {
          "properties": {
            "question": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "type": {
                  "type": "keyword"
                }
              }
            },
            "answers": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "type": {
                  "type": "keyword"
                },
                "data": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": {
                  "type": "keyword"
                },
                "referrer": {
                  "type": "keyword"
                }
              }
            },
            "response": {
              "properties": {
                "status_code": {
                  "type": "long"
                },
                "body": {
                  "properties": {
                    "bytes": {
                      "type": "long"
                    }
                  }
                }
              }
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "tls": {
          "properties": {
            "version": {
              "type": "keyword"
            },
            "cipher": {
              "type": "keyword"
            },
            "server": {
              "properties": {
                "certificate": {
                  "type": "keyword"
                },
                "ja3s": {
                  "type": "keyword"
                }
              }
            },
            "client": {
              "properties": {
                "ja3": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "url": {
          "properties": {
            "domain": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            },
            "full": {
              "type": "keyword"
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": {
              "type": "keyword"
            }
          }
        },
        "alert": {
          "properties": {
            "signature": {
              "type": "keyword"
            },
            "signature_id": {
              "type": "long"
            },
            "category": {
              "type": "keyword"
            },
            "severity": {
              "type": "long"
            }
          }
        },
        "tags": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        }
      }
    }
  },
  "priority": 100,
  "version": 1,
  "_meta": {
    "description": "Index template for network data from Security Onion (Zeek, Suricata)",
    "managed": true
  }
}
