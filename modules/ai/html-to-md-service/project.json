{
  "name": "ai-html-to-md-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/ai/html-to-md-service",
  "projectType": "application",
  "tags": ["scope:ai", "type:service", "tech:go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o bin/server .",
        "cwd": "modules/ai/html-to-md-service"
      },
      "outputs": ["{projectRoot}/bin"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run .",
        "cwd": "modules/ai/html-to-md-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -v ./...",
        "cwd": "modules/ai/html-to-md-service"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t html-to-md-service .",
        "cwd": "modules/ai/html-to-md-service"
      }
    }
  }
}
