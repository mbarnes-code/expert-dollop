{
  "name": "ai-playwright-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "modules/ai/playwright-service",
  "projectType": "application",
  "tags": ["scope:ai", "type:service", "tech:typescript"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "modules/ai/playwright-service"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "modules/ai/playwright-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "modules/ai/playwright-service"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t playwright-service .",
        "cwd": "modules/ai/playwright-service"
      }
    }
  }
}
