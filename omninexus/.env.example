# Environment Variables
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/unified_frontend

# Redis
REDIS_URL=redis://localhost:6379

# External APIs
# MTG Domain
SPELLBOOK_API_URL=http://localhost:8000
SCRYFALL_API_URL=https://api.scryfall.com

# Security Domain
SECURITY_API_URL=http://localhost:8001

# Finance Domain
ACTUAL_BUDGET_URL=http://localhost:5006

# AI Domain
GOOSE_API_URL=http://localhost:8002
MCP_INSPECTOR_URL=http://localhost:8003
NVIDIA_API_KEY=your-nvidia-api-key

# Ingestion Domain
FIRECRAWL_API_URL=http://localhost:8004
FIRECRAWL_API_KEY=your-firecrawl-api-key
